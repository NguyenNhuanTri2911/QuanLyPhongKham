<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Modern Material 3 Theme -->
    <style name="Base.Theme.AppHealthMate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/medical_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/medical_blue_light</item>
        <item name="colorSecondary">@color/medical_teal</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:statusBarColor">@color/medical_blue_deep</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.AppHealthMate" parent="Base.Theme.AppHealthMate" />

    <!-- Vô hiệu hóa SplashScreen StartingWindow mặc định trên API 31+ vốn dễ treo lớp phủ đen trên Android 37 Beta -->
    <style name="Theme.AppHealthMate.Launcher" parent="Theme.AppHealthMate">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Modern Outlined TextInputLayout (14dp rounded corners) -->
    <style name="HealthMate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/medical_blue</item>
        <item name="boxBackgroundColor">@color/bg_subtle</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- Primary Action Button -->
    <style name="HealthMate.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/medical_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Soft Tonal Button -->
    <style name="HealthMate.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/medical_blue_dark</item>
        <item name="backgroundTint">@color/medical_blue_light</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Outlined Button -->
    <style name="HealthMate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border_gray</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Modern Card Style -->
    <style name="HealthMate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_gray</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Theme.QuanLyPhongKham" parent="Theme.AppHealthMate" />
</resources>
