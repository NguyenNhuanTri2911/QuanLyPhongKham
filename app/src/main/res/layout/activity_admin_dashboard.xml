<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Curved Admin Hero Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_admin"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_squircle_white_glass">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hospital_shield"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_glass"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="ADMIN CONTROL CENTER"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Quản trị Hệ thống HealthMate"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_badge_glass"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-28dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Overlapping KPI Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/border_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="LIVE SQL SERVER METRICS"
                        android:textColor="@color/medical_blue_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKpiSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_subtle_box"
                        android:lineSpacingExtra="6dp"
                        android:padding="14dp"
                        android:text="Đang tải thống kê..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Phân hệ Quản trị Bệnh viện (6 Modules)"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Module 1 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoDoctors"
                style="@style/HealthMate.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="1. Quản lý Đội ngũ Bác sĩ (Thêm / Tạm nghỉ)"
                app:icon="@drawable/ic_doctor"
                app:iconPadding="12dp"
                app:iconSize="22dp" />

            <!-- Module 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoPatients"
                style="@style/HealthMate.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="2. Quản lý Hồ sơ Bệnh nhân (Khóa / Mở khóa)"
                app:icon="@drawable/ic_user"
                app:iconPadding="12dp"
                app:iconSize="22dp"
                app:iconTint="@color/medical_blue_dark" />

            <!-- Module 3 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoDepartments"
                style="@style/HealthMate.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="3. Quản lý Danh mục Chuyên khoa"
                app:icon="@drawable/ic_hospital_shield"
                app:iconPadding="12dp"
                app:iconSize="22dp"
                app:iconTint="@color/medical_blue_dark" />

            <!-- Module 4 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoRooms"
                style="@style/HealthMate.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="4. Quản lý Danh sách Phòng khám"
                app:icon="@drawable/ic_home"
                app:iconPadding="12dp"
                app:iconSize="22dp"
                app:iconTint="@color/medical_blue_dark" />

            <!-- Module 5 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoSchedules"
                style="@style/HealthMate.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="5. Duyệt Lịch trực Bác sĩ &amp; Gán Phòng khám"
                app:backgroundTint="@color/medical_teal_dark"
                app:icon="@drawable/ic_calendar"
                app:iconPadding="12dp"
                app:iconSize="22dp" />

            <!-- Module 6 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoAppointments"
                style="@style/HealthMate.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="18dp"
                android:text="6. Giám sát Toàn bộ Lịch hẹn Khám"
                app:icon="@drawable/ic_clock"
                app:iconPadding="12dp"
                app:iconSize="22dp"
                app:iconTint="@color/medical_blue_dark" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
